#!/usr/bin/env php
<?php

declare(strict_types=1);

use LaravelModelSchema\LiveSchema;
use LaravelModelSchema\NativeBinary;

$autoloadCandidates = [];
if (isset($GLOBALS['_composer_autoload_path']) && is_string($GLOBALS['_composer_autoload_path'])) {
    $autoloadCandidates[] = $GLOBALS['_composer_autoload_path'];
}
$autoloadCandidates[] = dirname(__DIR__, 4) . '/autoload.php';
$autoloadCandidates[] = dirname(__DIR__, 2) . '/vendor/autoload.php';

$loaded = false;
foreach ($autoloadCandidates as $autoload) {
    if ($autoload !== '' && is_file($autoload)) {
        require $autoload;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "Error: Composer autoloader not found. Run 'composer install' first.\n");
    exit(1);
}

try {
    $packageRoot = dirname(__DIR__, 2);
    $binary = NativeBinary::resolve($packageRoot);
    $args = $_SERVER['argv'] ?? [];
    array_shift($args);

    // Prefer the live database over parsing migrations when the app is reachable.
    if (LiveSchema::wanted($args)) {
        try {
            $live = LiveSchema::dump((string) getcwd());
            $args[] = '--schema-json';
            $args[] = $live['path'];
            fwrite(STDERR, "Using live database schema ({$live['connection']}, {$live['tables']} tables). Pass --no-live to parse migrations instead.\n");
        } catch (Throwable $e) {
            fwrite(STDERR, 'Live database unavailable (' . $e->getMessage() . "); parsing migrations.\n");
        }
    }

    NativeBinary::execute($binary, $args);
} catch (Throwable $e) {
    fwrite(STDERR, 'Error: ' . $e->getMessage() . "\n");
    exit(1);
}
